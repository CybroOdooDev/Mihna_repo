<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="HrDashboardMain">
        <div class="oh_dashboards">
            <div class="container-fluid o_hr_dashboard">
                
                <!-- TOP BAR -->
                <div class="dashboard-top-bar">
                    <div class="top-bar-left">
                        <button class="top-bar-btn outline-btn" style="border-radius: 999px;">
                            <i class="fa fa-calendar-o" style="margin-right: 8px; color: #6B7280;"/> This month <i class="fa fa-chevron-down" style="margin-left: 8px; color: #9CA3AF; font-size: 10px;"/>
                        </button>
                    </div>
                    <div class="top-bar-right">
                        <button class="top-bar-btn outline-btn export-btn" style="border-radius: 8px;">
                            <i class="fa fa-download" style="margin-right: 8px;"/> Export
                        </button>
                        <button class="top-bar-btn action-btn-danger" t-on-click="attendance_sign_in_out" style="border-radius: 8px; font-weight: 600;">
                            <t t-if="this.state.login_employee['attendance_state'] =='checked_in'">
                                <i class="fa fa-sign-out" style="margin-right: 8px;"/> Check Out
                            </t>
                            <t t-else="">
                                <i class="fa fa-sign-in" style="margin-right: 8px;"/> Check In
                            </t>
                        </button>
                        <div class="top-bar-icon-btn">
                            <i class="fa fa-bell-o"/>
                            <span class="notification-badge">3</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <div class="top-bar-avatar">
                                <span class="initials">
                                    <t t-if="this.state.login_employee"><t t-esc="this.state.login_employee['name'].substring(0, 2).toUpperCase()"/></t>
                                </span>
                            </div>
                            <i class="fa fa-chevron-down" style="color: #9CA3AF; font-size: 10px;"/>
                        </div>
                    </div>
                </div>

                <div style="padding: 0 32px 32px 32px;">
                    <t t-if="this.state.login_employee">
                        <t t-if="this.state.is_manager == true">
                            <t t-call="LoginEmployeeDetails"/>
                            <t t-call="ManagerDashboard"/>
                            <t t-call="EmployeeDashboard"/>
                        </t>
                        <t t-else="">
                            <t t-call="LoginEmployeeDetails"/>
                            <t t-call="EmployeeDashboard"/>
                        </t>
                    </t>
                </div>
            </div>
        </div>
     </t>

    <!-- LoginEmployeeDetails (Top Stats + Checkin Card + Profile Card + Attendance Trend) -->
    <t t-name="LoginEmployeeDetails">
        <link rel="stylesheet" href="/hrms_dashboard/static/src/css/dashboard.css"/>
        
        <!-- Row 1: Top Row (Payslips, Timesheets, Contracts, Broad Factor, Check-In) -->
        <div class="dashboard-grid-5">
            <div class="modern-card top-stat-card clickable hr_payslip" t-on-click="hr_payslip">
                <div class="stat-card-header">
                    <div class="stat-card-icon bg-purple-light">
                        <i class="fa fa-file-text-o"/>
                    </div>
                    <div>
                        <div class="stat-card-title">Payslips</div>
                        <div class="stat-card-subtitle">This month</div>
                    </div>
                </div>
                <div class="stat-card-value"><t t-esc="this.state.login_employee['payslip_count']"/></div>
                <div class="sparkline-container" style="position: absolute; bottom: 16px; left: 20px; width: calc(100% - 40px); height: 32px; z-index: 1; opacity: 0.8; background: url('data:image/svg+xml;utf8,&lt;svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 20\' preserveAspectRatio=\'none\'&gt;&lt;defs&gt;&lt;linearGradient id=\'g1\' x1=\'0\' y1=\'0\' x2=\'0\' y2=\'1\'&gt;&lt;stop offset=\'0%\' stop-color=\'%238A2BE2\' stop-opacity=\'0.4\'/&gt;&lt;stop offset=\'100%\' stop-color=\'%238A2BE2\' stop-opacity=\'0\'/&gt;&lt;/linearGradient&gt;&lt;/defs&gt;&lt;path d=\'M0,15 L20,12 L40,16 L60,8 L80,10 L100,5 L100,20 L0,20 Z\' fill=\'url(%23g1)\' stroke=\'none\'/&gt;&lt;path d=\'M0,15 L20,12 L40,16 L60,8 L80,10 L100,5\' fill=\'none\' stroke=\'%238A2BE2\' stroke-width=\'1.5\'/&gt;&lt;/svg&gt;') no-repeat center bottom; background-size: 100% 100%;"></div>
            </div>
            
            <div class="modern-card top-stat-card clickable hr_timesheets" t-on-click="hr_timesheets">
                <div class="stat-card-header">
                    <div class="stat-card-icon bg-blue-light">
                        <i class="fa fa-clock-o"/>
                    </div>
                    <div>
                        <div class="stat-card-title">Timesheets</div>
                        <div class="stat-card-subtitle">Pending</div>
                    </div>
                </div>
                <div class="stat-card-value"><t t-esc="this.state.login_employee['emp_timesheets']"/></div>
                <div class="sparkline-container" style="position: absolute; bottom: 16px; left: 20px; width: calc(100% - 40px); height: 32px; z-index: 1; opacity: 0.8; background: url('data:image/svg+xml;utf8,&lt;svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 20\' preserveAspectRatio=\'none\'&gt;&lt;defs&gt;&lt;linearGradient id=\'g2\' x1=\'0\' y1=\'0\' x2=\'0\' y2=\'1\'&gt;&lt;stop offset=\'0%\' stop-color=\'%233B82F6\' stop-opacity=\'0.4\'/&gt;&lt;stop offset=\'100%\' stop-color=\'%233B82F6\' stop-opacity=\'0\'/&gt;&lt;/linearGradient&gt;&lt;/defs&gt;&lt;path d=\'M0,5 L25,12 L50,10 L75,16 L100,12 L100,20 L0,20 Z\' fill=\'url(%23g2)\' stroke=\'none\'/&gt;&lt;path d=\'M0,5 L25,12 L50,10 L75,16 L100,12\' fill=\'none\' stroke=\'%233B82F6\' stroke-width=\'1.5\'/&gt;&lt;/svg&gt;') no-repeat center bottom; background-size: 100% 100%;"></div>
            </div>
            
            <div class="modern-card top-stat-card clickable hr_contract" t-on-click="hr_contract">
                <div class="stat-card-header">
                    <div class="stat-card-icon bg-teal-light">
                        <i class="fa fa-briefcase"/>
                    </div>
                    <div>
                        <div class="stat-card-title">Contracts</div>
                        <div class="stat-card-subtitle">Running</div>
                    </div>
                </div>
                <div class="stat-card-value"><t t-esc="this.state.login_employee['contracts_count']"/></div>
                <div class="sparkline-container" style="position: absolute; bottom: 16px; left: 20px; width: calc(100% - 40px); height: 32px; z-index: 1; opacity: 0.8; background: url('data:image/svg+xml;utf8,&lt;svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 20\' preserveAspectRatio=\'none\'&gt;&lt;defs&gt;&lt;linearGradient id=\'g3\' x1=\'0\' y1=\'0\' x2=\'0\' y2=\'1\'&gt;&lt;stop offset=\'0%\' stop-color=\'%2314B8A6\' stop-opacity=\'0.4\'/&gt;&lt;stop offset=\'100%\' stop-color=\'%2314B8A6\' stop-opacity=\'0\'/&gt;&lt;/linearGradient&gt;&lt;/defs&gt;&lt;path d=\'M0,15 L30,14 L60,10 L80,12 L100,5 L100,20 L0,20 Z\' fill=\'url(%23g3)\' stroke=\'none\'/&gt;&lt;path d=\'M0,15 L30,14 L60,10 L80,12 L100,5\' fill=\'none\' stroke=\'%2314B8A6\' stroke-width=\'1.5\'/&gt;&lt;/svg&gt;') no-repeat center bottom; background-size: 100% 100%;"></div>
            </div>
            
            <div class="modern-card top-stat-card clickable login_broad_factor" t-on-click="employee_broad_factor">
                <div class="stat-card-header">
                    <div class="stat-card-icon bg-orange-light">
                        <i class="fa fa-line-chart"/>
                    </div>
                    <div>
                        <div class="stat-card-title">Broad Factor</div>
                        <div class="stat-card-subtitle">Bradford</div>
                    </div>
                </div>
                <div class="stat-card-value"><t t-esc="this.state.login_employee['broad_factor']"/></div>
                <div class="sparkline-container" style="position: absolute; bottom: 16px; left: 20px; width: calc(100% - 40px); height: 32px; z-index: 1; opacity: 0.8; background: url('data:image/svg+xml;utf8,&lt;svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 20\' preserveAspectRatio=\'none\'&gt;&lt;defs&gt;&lt;linearGradient id=\'g4\' x1=\'0\' y1=\'0\' x2=\'0\' y2=\'1\'&gt;&lt;stop offset=\'0%\' stop-color=\'%23F97316\' stop-opacity=\'0.4\'/&gt;&lt;stop offset=\'100%\' stop-color=\'%23F97316\' stop-opacity=\'0\'/&gt;&lt;/linearGradient&gt;&lt;/defs&gt;&lt;path d=\'M0,8 L20,12 L40,8 L60,15 L80,14 L100,18 L100,20 L0,20 Z\' fill=\'url(%23g4)\' stroke=\'none\'/&gt;&lt;path d=\'M0,8 L20,12 L40,8 L60,15 L80,14 L100,18\' fill=\'none\' stroke=\'%23F97316\' stroke-width=\'1.5\'/&gt;&lt;/svg&gt;') no-repeat center bottom; background-size: 100% 100%;"></div>
            </div>

            <!-- CHECK-IN CARD -->
            <div class="modern-card checkin-card" t-ref="log_in_out">
                <div>
                    <div class="checkin-header">
                        <t t-if="this.state.login_employee['attendance_state'] =='checked_out'">Checked Out</t>
                        <t t-else="">Checked In</t>
                        <span style="float:right; width: 8px; height: 8px; border-radius: 50%; background-color: #4ade80; display: inline-block;"></span>
                    </div>
                    <div class="checkin-time">
                        <t t-if="this.state.login_employee['attendance_state'] =='checked_out'">--:--:--</t>
                        <t t-else="">06:46:35</t>
                    </div>
                    <div class="checkin-status">
                        <t t-if="this.state.login_employee['attendance_state'] =='checked_in'">Since 09:02 AM today</t>
                    </div>
                </div>
                <div class="btn-checkin-action" t-on-click="attendance_sign_in_out">
                    <t t-if="this.state.login_employee['attendance_state'] =='checked_out'">
                        <i class="fa fa-sign-in mr-2"/> Check In
                    </t>
                    <t t-else="">
                        [-> Check Out
                    </t>
                </div>
            </div>
        </div>

        <!-- Row 2: Profile Card + Attendance Trend -->
        <div class="dashboard-grid-2-profile">
            <!-- Profile Card -->
            <div class="modern-card profile-card employee_prof">
                <div class="profile-header-bg"></div>
                
                <t t-if="this.state.login_employee['attendance_state'] =='checked_in'">
                    <div class="profile-active-dot"></div>
                </t>
                
                <div class="profile-avatar-wrapper">
                    <t t-if="this.state.login_employee['image_1920']">
                        <img class="profile-avatar" t-att-src="'data:image/png;base64,'+this.state.login_employee['image_1920']" alt="Profile"/>
                    </t>
                    <t t-else="">
                        <div class="profile-initials">
                            <t t-esc="this.state.login_employee['name'].substring(0, 2).toUpperCase()"/>
                        </div>
                    </t>
                </div>
                
                <div class="profile-details">
                    <div class="profile-name"><t t-esc="this.state.login_employee['name']"/></div>
                    <div class="profile-job">
                        <t t-if="this.state.login_employee['job_id']"><t t-esc="this.state.login_employee['job_id'][1]"/></t>
                        <t t-else="">HR Manager</t>
                        · <t t-esc="this.state.login_employee['department_id'] ? this.state.login_employee['department_id'][1] : 'Human Resources'"/>
                    </div>
                    
                    <div class="profile-grid-info">
                        <div class="info-block">
                            <span class="info-label">Position</span>
                            <span class="info-value">
                                <t t-if="this.state.login_employee['job_id']"><t t-esc="this.state.login_employee['job_id'][1]"/></t>
                                <t t-else="">HR Manager</t>
                            </span>
                        </div>
                        <div class="info-block">
                            <span class="info-label">Department</span>
                            <span class="info-value">
                                <t t-if="this.state.login_employee['department_id']"><t t-esc="this.state.login_employee['department_id'][1]"/></t>
                                <t t-else="">Human Resources</t>
                            </span>
                        </div>
                        <div class="info-block">
                            <span class="info-label">Joined</span>
                            <span class="info-value">
                                <t t-if="this.state.login_employee['experience']"><t t-esc="this.state.login_employee['experience']"/> Ago</t>
                                <t t-else="">Mar 2021</t>
                            </span>
                        </div>
                        <div class="info-block">
                            <span class="info-label">Employee ID</span>
                            <span class="info-value">
                                <t t-if="this.state.login_employee['barcode']"><t t-esc="this.state.login_employee['barcode']"/></t>
                                <t t-else="">EMP-0241</t>
                            </span>
                        </div>
                        <div class="info-block">
                            <span class="info-label">Nationality</span>
                            <span class="info-value">
                                <t t-if="this.state.login_employee['country_id']"><t t-esc="this.state.login_employee['country_id'][1]"/></t>
                                <t t-else="">India</t>
                            </span>
                        </div>
                        <div class="info-block">
                            <span class="info-label">Contact</span>
                            <span class="info-value">
                                <t t-if="this.state.login_employee['mobile_phone']"><t t-esc="this.state.login_employee['mobile_phone']"/></t>
                                <t t-else="">+91 90742 70811</t>
                            </span>
                        </div>
                    </div>
                </div>
                
                <div class="profile-status-box">
                    <div class="profile-status-text">
                        <i class="fa fa-clock-o"/>
                        <div style="line-height: 1.2;">
                            <div>Checked in - 6h 42m</div>
                            <div style="font-size: 10px; color: #94a3b8; margin-top: 2px;">Since 09:02 AM today</div>
                        </div>
                    </div>
                    <div class="profile-status-dot"></div>
                </div>
            </div>

            <!-- Attendance Trend -->
            <div class="modern-card chart-card user_attendance_trend">
                <div class="chart-header">
                    <span>Attendance trend</span>
                    <span class="badge badge-this-week"><i class="fa fa-circle" style="font-size: 8px; margin-right: 4px; color: #3B82F6;"></i>This week</span>
                </div>
                <div class="chart-wrapper trend-graph" t-ref="leave_trend">
                    <canvas id="leaveTrendChart"></canvas>
                </div>
            </div>
        </div>
    </t>

    <!-- ManagerDashboard -->
    <t t-name="ManagerDashboard">
        <!-- Row 3: Manager Stat Cards -->
        <div class="dashboard-grid-3">
            <div class="modern-card manager-stat-card clickable hr_leave_request_approve" t-on-click="leaves_to_approve">
                <div class="manager-icon-wrap bg-amber-light">
                    <i class="fa fa-plane"/>
                </div>
                <div>
                    <div class="manager-val"><t t-esc="this.state.login_employee.leaves_to_approve"/></div>
                    <div class="manager-title">Leave Requests</div>
                </div>
            </div>
            
            <div class="modern-card manager-stat-card clickable hr_leave_allocations_approve" t-on-click="leave_allocations_to_approve">
                <div class="manager-icon-wrap bg-sky-light">
                    <i class="fa fa-calendar-plus-o"/>
                </div>
                <div>
                    <div class="manager-val"><t t-esc="this.state.login_employee.leaves_alloc_req"/></div>
                    <div class="manager-title">Leave Allocations</div>
                </div>
            </div>
            
            <div class="modern-card manager-stat-card clickable hr_job_application_approve" t-on-click="job_applications_to_approve">
                <div class="manager-icon-wrap bg-indigo-light">
                    <i class="fa fa-suitcase"/>
                </div>
                <div>
                    <div class="manager-val"><t t-esc="this.state.login_employee.job_applications"/></div>
                    <div class="manager-title">Job Applications</div>
                </div>
            </div>
        </div>

        <!-- Row 4: Charts -->
        <div class="dashboard-grid-2">
            <div class="modern-card chart-card graph_view">
                <div class="chart-header">Employees by department</div>
                <div class="chart-wrapper emp_graph" style="display: flex; align-items: center; justify-content: space-between;" t-ref="emp_graph">
                    <div style="width: 50%; height: 250px; position: relative;">
                        <canvas id="employeePieChart"></canvas>
                    </div>
                    <div id="employeePieLegend" class="custom-pie-legend" style="width: 45%; max-height: 250px; overflow-y: auto;"></div>
                </div>
            </div>
            
            <div class="modern-card chart-card monthly_leave_graph_view">
                <div class="chart-header">
                    <span>Monthly leave analysis</span>
                    <span class="badge" style="background-color: #F1F5F9; color: #64748B; border-radius: 12px; font-weight: 600; padding: 4px 12px; font-size: 11px;">2026</span>
                </div>
                <div class="chart-wrapper leave_graph" t-ref="leave_graph">
                    <canvas id="leave_barChart"></canvas>
                    <canvas id="leave_doughnutChart" style="display:none;"></canvas>
                </div>
            </div>
        </div>

        <!-- Row 5: Charts -->
        <div class="dashboard-grid-2">
            <div class="modern-card chart-card monthly_join_resign_trend">
                <div class="chart-header">Join / Resign Analysis</div>
                <div class="chart-wrapper join_resign_trend" t-ref="join_resign_trend">
                    <canvas id="lineChart"></canvas>
                </div>
            </div>
            
            <div class="modern-card chart-card monthly_attrition_rate">
                <div class="chart-header">Attrition Rate</div>
                <div class="chart-wrapper attrition_rate" t-ref="attrition_rate">
                    <canvas id="attritionRateChart"></canvas>
                </div>
            </div>
        </div>
    </t>

    <!-- EmployeeDashboard -->
    <t t-name="EmployeeDashboard">
        <!-- Tables Row -->
        <div class="dashboard-grid-2">
            <div class="modern-card chart-card user_attendance">
                <div class="chart-header">
                    <span>Recent Attendance</span>
                    <span class="add-btn" t-on-click="add_attendance"><i class="fa fa-plus"/> Add</span>
                </div>
                <div style="overflow-x: auto; flex-grow: 1;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Sign In</th>
                                <th>Sign Out</th>
                                <th>Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="this.state.login_employee['attendance_lines']" t-as="lines" t-key="lines['id']">
                                <td t-esc="lines['date']"/>
                                <td t-esc="lines['sign_in']"/>
                                <td t-esc="lines['sign_out']"/>
                                <td t-esc="lines['worked_hours']"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="modern-card chart-card user_leaves">
                <div class="chart-header">
                    <span>My Leaves</span>
                    <span class="add-btn" t-on-click="add_leave"><i class="fa fa-plus"/> Request</span>
                </div>
                <div style="overflow-x: auto; flex-grow: 1;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>From</th>
                                <th>To</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="this.state.login_employee['leave_lines']" t-as="lines" t-key="lines['id']">
                                <td t-esc="lines['request_date_from']"/>
                                <td t-esc="lines['request_date_to']"/>
                                <td t-esc="lines['type']"/>
                                <td><span class="badge" t-esc="lines['state']" t-attf-style="background: #{lines['color']};"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="dashboard-grid-2">
            <div class="modern-card chart-card user_expense">
                <div class="chart-header">
                    <span>My Expenses</span>
                    <span class="add-btn" t-on-click="add_expense"><i class="fa fa-plus"/> New</span>
                </div>
                <div style="overflow-x: auto; flex-grow: 1;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Subject</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="this.state.login_employee['expense_lines']" t-as="lines" t-key="lines['id']">
                                <td t-esc="lines['date']"/>
                                <td t-esc="lines['name']"/>
                                <td t-esc="lines['total_amount']"/>
                                <td><span class="badge" t-esc="lines['state']" t-attf-style="background: #{lines['color']};"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="modern-card chart-card projects">
                <div class="chart-header">
                    <span>My Tasks</span>
                    <span class="add-btn" t-on-click="add_project_task"><i class="fa fa-plus"/> New Task</span>
                </div>
                <div style="overflow-x: auto; flex-grow: 1;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Project</th>
                                <th>Task</th>
                                <th>Due Date</th>
                                <th>Stage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="this.state.login_employee['project_task_lines']" t-as="lines" t-key="lines['id']">
                                <td t-esc="lines['project_name']"/>
                                <td t-esc="lines['task_name']"/>
                                <td t-esc="lines['date_deadline']"/>
                                <td><span class="badge" t-esc="lines['stage_name']" style="background: #64748b;"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Notifications & Skill Chart Row -->
        <div class="dashboard-grid-3">
            <!-- Announcements -->
            <div class="modern-card notification-card">
                <div class="chart-header">Announcements</div>
                <div class="notification-list">
                    <t t-if="this.state.announcements and this.state.announcements.length > 0">
                        <t t-foreach="this.state.announcements" t-as="announcement" t-key="announcement">
                            <div class="notification-item">
                                <div class="notif-icon bg-blue-light"><i class="fa fa-bullhorn"/></div>
                                <div class="notif-content">
                                    <div class="notif-title"><t t-esc="announcement['announcement_reason']"/></div>
                                    <div class="notif-desc"><t t-esc="announcement['date_start']"/></div>
                                </div>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="empty-state">
                            <i class="fa fa-bell-o empty-icon"/>
                            <div class="empty-text">No announcements</div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Upcoming Events -->
            <div class="modern-card notification-card">
                <div class="chart-header">Upcoming Events</div>
                <div class="notification-list">
                    <t t-if="this.state.upcoming_events and this.state.upcoming_events.length > 0">
                        <t t-foreach="this.state.upcoming_events" t-as="event" t-key="event['id']">
                            <div class="notification-item">
                                <div class="notif-icon bg-purple-light"><i class="fa fa-calendar"/></div>
                                <div class="notif-content">
                                    <div class="notif-title"><t t-esc="event['name']"/></div>
                                    <div class="notif-desc"><t t-esc="event['date_begin']"/></div>
                                </div>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="empty-state">
                            <i class="fa fa-calendar-o empty-icon"/>
                            <div class="empty-text">No upcoming events</div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Upcoming Birthdays -->
            <div class="modern-card notification-card">
                <div class="chart-header">Upcoming Birthdays</div>
                <div class="notification-list">
                    <t t-if="this.state.employee_birthday and this.state.employee_birthday.length > 0">
                        <t t-foreach="this.state.employee_birthday" t-as="employee" t-key="employee['id']">
                            <div class="notification-item">
                                <img t-attf-src="/web/image?model=hr.employee&amp;id={{employee['id']}}&amp;field=image_1920" class="notif-icon" style="padding:0; object-fit: cover; border: none;"/>
                                <div class="notif-content">
                                    <div class="notif-title"><t t-esc="employee['name']"/></div>
                                    <div class="notif-desc">
                                        <t t-esc="employee['birthday']"/>
                                        <t t-if="employee['is_birthday']"><span style="color: #f97316; margin-left: 5px;">🎉 Today!</span></t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="empty-state">
                            <i class="fa fa-gift empty-icon"/>
                            <div class="empty-text">No upcoming birthdays</div>
                        </div>
                    </t>
                </div>
            </div>
        </div>

        <div class="dashboard-grid-2">
            <!-- My Skill Analysis -->
            <div class="modern-card chart-card">
                <div class="chart-header">My Skill Analysis</div>
                <div class="chart-wrapper skill">
                    <canvas id="skillChart"></canvas>
                </div>
            </div>
        </div>
    </t>

    <!-- EmployeeWarning -->
    <t t-name="EmployeeWarning">
        <div>
            <p>Error : Could not find employee linked to user</p>
            <p>Please contact system admin for the setup</p>
        </div>
    </t>

</templates>
