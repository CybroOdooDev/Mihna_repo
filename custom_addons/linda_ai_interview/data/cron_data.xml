<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_process_scoring" model="ir.cron">
        <field name="name">Linda: process scoring queue</field>
        <field name="model_id" ref="model_ai_interview_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_scoring()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_expire_invites" model="ir.cron">
        <field name="name">Linda: expire invites and abandoned sessions</field>
        <field name="model_id" ref="model_ai_interview_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_invites()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="ir_cron_purge_retention" model="ir.cron">
        <field name="name">Linda: purge data past retention</field>
        <field name="model_id" ref="model_ai_interview_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_retention()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="ir_cron_validate_questions" model="ir.cron">
        <field name="name">Linda: validate generated questions</field>
        <field name="model_id" ref="model_ai_interview_question"/>
        <field name="state">code</field>
        <field name="code">model._cron_validate_pending()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
