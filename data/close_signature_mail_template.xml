<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_subscription_close_signature_v2" model="mail.template">
            <field name="name">Subscription: Closed Signature Request</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Signature Required: Closure of Subscription {{ object.name }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Sent to customers when their subscription is closed to request a final signature</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_id.name or 'Customer'"></t>,<br/><br/>
        Your subscription <strong><t t-out="object.name"></t></strong> has been marked for closure.<br/><br/>
        We require your final signature to complete the cancellation process. Please click the button below to sign the cancellation document.
        <br/><br/>
        <div style="margin: 16px 0px 16px 0px; text-align: center;">
            <a t-att-href="object.get_portal_url(suffix='/close_signature')"
                style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px;">
                To Do Signature
            </a>
        </div>
        <br/><br/>
        Thank you,<br/>
        <t t-out="object.company_id.name"></t>
    </p>
</div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
