<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Salary Rule for Asset Recovery -->
        <record id="hr_salary_rule_asset_recovery" model="hr.salary.rule">
            <field name="name">Asset Recovery</field>
            <field name="sequence" eval="90"/>
            <field name="code">ASSET_REC</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.ASSET_RECOVERY)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -inputs.ASSET_RECOVERY.amount if inputs.ASSET_RECOVERY else 0.0</field>
        </record>

        <!-- Salary Rule for Notice Recovery -->
        <record id="hr_salary_rule_notice_recovery" model="hr.salary.rule">
            <field name="name">Notice Recovery</field>
            <field name="sequence" eval="91"/>
            <field name="code">NOTICE_REC</field>
            <field name="category_id" ref="hr_payroll_community.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.NOTICE_RECOVERY)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -inputs.NOTICE_RECOVERY.amount if inputs.NOTICE_RECOVERY else 0.0</field>
        </record>

        <!-- Automatically add these rules to all salary structures -->
        <function model="hr.resignation" name="_add_recovery_rules_to_structures"/>
    </data>
</odoo>
