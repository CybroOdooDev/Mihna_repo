<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Application Category -->
        <record id="module_category_subscription_management" model="ir.module.category">
            <field name="name">Subscriptions</field>
            <field name="description">Manage Subscriptions</field>
            <field name="sequence">10</field>
        </record>

        <!-- Privilege -->
        <record model="res.groups.privilege" id="res_groups_privilege_subscription">
            <field name="name">Subscriptions</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_subscription_management"/>
        </record>

        <!-- Groups -->
        <record id="group_subscription_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_subscription"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">The user will have access to his own data in the subscription application.</field>
        </record>

        <record id="group_subscription_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_subscription"/>
            <field name="implied_ids" eval="[(4, ref('group_subscription_user'))]"/>
            <field name="comment">The user will have access to all records of everyone in the subscription application.</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
    <data noupdate="1">
        <!-- Multi-Company Rules -->
        <record id="subscription_plan_company_rule" model="ir.rule">
            <field name="name">Subscription Plan multi-company</field>
            <field name="model_id" ref="model_subscription_plan"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="subscription_subscription_company_rule" model="ir.rule">
            <field name="name">Subscription multi-company</field>
            <field name="model_id" ref="model_subscription_subscription"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        
        <!-- Record Rules for Users / Managers -->
        
        <!-- Portal User Record Rule -->
        <record id="subscription_subscription_portal_rule" model="ir.rule">
            <field name="name">Subscription Portal rule</field>
            <field name="model_id" ref="model_subscription_subscription"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="subscription_line_portal_rule" model="ir.rule">
            <field name="name">Subscription Line Portal rule</field>
            <field name="model_id" ref="model_subscription_line"/>
            <field name="domain_force">[('subscription_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
