<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit and customize Quotation Templates form view -->
    <record id="sale_order_template_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.template.form.inherit</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <!-- 1. Above the main title, replace standard label with 'Template' -->
            <xpath expr="//div[@name='sale_order_template_title']/label[@for='name']" position="replace">
                <div class="text-muted fw-bold mb-1" style="font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px; color: #7c7c7c !important;">Template</div>
            </xpath>

            <!-- 2. Re-arrange and layout fields on the left column to exactly match the screenshot -->
            <xpath expr="//group" position="replace">
                <group style="margin-top: 1rem; margin-bottom: 1rem;">
                    <group name="subscription_template_left" style="width: 50%;">
                        <field name="plan_id" options="{'no_create': True}"/>
                        <field name="is_forever"/>
                        <label for="duration_value" string="End After" invisible="is_forever"/>
                        <div class="o_row" invisible="is_forever">
                            <field name="duration_value" class="oe_inline" style="width: 4rem; margin-right: 0.5rem;"/>
                            <field name="duration_unit" class="oe_inline"/>
                        </div>
                        <field name="template_type"/>
                        <field name="quote_calculator"/>
                        <field name="is_shared"/>
                        <field name="sales_team_id" options="{'no_create': True}"/>
                        <field name="company_id" options="{'no_create': True}"/>
                    </group>
                    <group name="subscription_template_right" style="width: 50%;">
                        <!-- Left blank to match the layout in the screenshot -->
                    </group>
                </group>
            </xpath>

            <!-- 3. Add 'Quote Builder' and 'Settings' tabs, and rename 'Lines' and 'Terms' -->
            <xpath expr="//notebook/page[@name='order_lines']" position="attributes">
                <attribute name="string">Lines</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='terms_and_conditions']" position="attributes">
                <attribute name="string">Terms &amp; Conditions</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='terms_and_conditions']" position="after">
                <page string="Quote Builder" name="quote_builder">
                    <div class="alert alert-info m-3" role="alert" style="border-radius: 6px;">
                        Interactive Quote Builder content goes here.
                    </div>
                </page>
                <page string="Settings" name="settings">
                    <group style="margin-top: 1rem;">
                        <group name="validity_settings">
                            <label for="number_of_days" string="Quotation Validity"/>
                            <div id="number_of_days">
                                <field name="number_of_days" class="oe_inline" style="width: 4rem; margin-right: 0.5rem;"/>
                                <span class="d-inline-block"> days</span>
                            </div>
                            <field name="mail_template_id" context="{'default_model': 'sale.order'}" options="{'no_create': True}"/>
                        </group>
                        <group name="payment_settings">
                            <field name="require_signature"/>
                            <label for="require_payment"/>
                            <div id="require_payment" class="o_row">
                                <field name="require_payment" class="oe_inline"/>
                                <span invisible="not require_payment" style="margin-left: 0.5rem; margin-right: 0.5rem;">of</span>
                                <field name="prepayment_percent"
                                       invisible="not require_payment"
                                       widget="percentage"
                                       class="oe_inline"
                                       style="width: 4rem;"/>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
