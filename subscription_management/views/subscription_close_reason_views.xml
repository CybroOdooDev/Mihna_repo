<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="subscription_close_reason_view_tree" model="ir.ui.view">
        <field name="name">subscription.close.reason.tree</field>
        <field name="model">subscription.close.reason</field>
        <field name="arch" type="xml">
            <list string="Subscription Close Reasons">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="visible_in_portal"/>
            </list>
        </field>
    </record>

    <record id="subscription_close_reason_view_form" model="ir.ui.view">
        <field name="name">subscription.close.reason.form</field>
        <field name="model">subscription.close.reason</field>
        <field name="arch" type="xml">
            <form string="Close Reason">
                <sheet>
                    <group>
                        <field name="name" string="Reason" placeholder="The reason for closing a subscription"/>
                        <field name="visible_in_portal" string="Selectable in Portal"/>
                    </group>
                    <div class="o_horizontal_separator mt-4 mb-3 fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; border-bottom: 1px solid #ddd; padding-bottom: 5px;">Portal: Retention Step</div>
                    <group>
                        <field name="retention_message" string="Message" placeholder="This message will be displayed to convince the customer to stay (e.g., We don't want you to leave, can we offer to schedule a meeting with your account manager?)"/>
                        <field name="retention_button_text" string="Button Text" placeholder="The text to display on the call to action"/>
                        <field name="retention_button_link" string="Button Link" placeholder="The redirect link of the call to action"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subscription_close_reason" model="ir.actions.act_window">
        <field name="name">Close Reasons</field>
        <field name="res_model">subscription.close.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Close/Cancellation Reason
            </p>
            <p>
                Track why your customers cancel or pause their subscriptions.
            </p>
        </field>
    </record>

    <!-- Close Reasons Menu defined after action -->
    <menuitem id="menu_subscription_close_reason" 
              name="Close Reasons" 
              parent="subscription_management.subscription_menu_configuration" 
              action="action_subscription_close_reason" 
              sequence="20"/>
</odoo>
