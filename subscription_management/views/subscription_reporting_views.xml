<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. MRR Breakdown Views -->
    <record id="view_subscription_mrr_breakdown_graph" model="ir.ui.view">
        <field name="name">subscription.mrr.breakdown.graph</field>
        <field name="model">subscription.mrr.breakdown</field>
        <field name="arch" type="xml">
            <graph string="MRR Breakdown" type="bar" sample="1">
                <field name="event_date" interval="month"/>
                <field name="event_type"/>
                <field name="mrr_change" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_mrr_breakdown_pivot" model="ir.ui.view">
        <field name="name">subscription.mrr.breakdown.pivot</field>
        <field name="model">subscription.mrr.breakdown</field>
        <field name="arch" type="xml">
            <pivot string="MRR Breakdown" sample="1">
                <field name="event_date" interval="month" type="row"/>
                <field name="event_type" type="col"/>
                <field name="mrr_change" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- 2. MRR Analysis Views -->
    <record id="view_subscription_mrr_analysis_graph" model="ir.ui.view">
        <field name="name">subscription.mrr.analysis.graph</field>
        <field name="model">subscription.mrr.analysis</field>
        <field name="arch" type="xml">
            <graph string="MRR Analysis" type="line" sample="1">
                <field name="date" interval="month"/>
                <field name="mrr_change" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_mrr_analysis_pivot" model="ir.ui.view">
        <field name="name">subscription.mrr.analysis.pivot</field>
        <field name="model">subscription.mrr.analysis</field>
        <field name="arch" type="xml">
            <pivot string="MRR Analysis" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="mrr_change" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- 3. Subscriptions Analysis Views -->
    <record id="view_subscription_analysis_report_graph" model="ir.ui.view">
        <field name="name">subscription.analysis.report.graph</field>
        <field name="model">subscription.analysis.report</field>
        <field name="arch" type="xml">
            <graph string="Subscriptions Analysis" type="bar" sample="1">
                <field name="monthly_recurring" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_analysis_report_search" model="ir.ui.view">
        <field name="name">subscription.analysis.report.search</field>
        <field name="model">subscription.analysis.report</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions Analysis">
                <filter string="In Progress or Paused" name="in_progress_or_paused" domain="[('state', 'in', ('in_progress', 'paused'))]"/>
                <filter string="Recurring" name="recurring" domain="[('is_recurring', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- 4. Retention Analysis Views -->
    <record id="view_subscription_retention_analysis_pivot" model="ir.ui.view">
        <field name="name">subscription.retention.analysis.pivot</field>
        <field name="model">subscription.retention.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Retention Analysis" sample="1">
                <field name="first_contract_date" interval="month" type="row"/>
                <field name="end_date_month" type="col"/>
                <field name="count" type="measure"/>
                <field name="retention_rate" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>
