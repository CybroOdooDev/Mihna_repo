<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_l10n_ae_aigentrix" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_ae_aigentrix</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="l10n_ae_aigentrix_document_ids" invisible="1"/>
                <field name="l10n_ae_aigentrix_document_count" invisible="1"/>
                <button name="action_l10n_ae_aigentrix_view_documents" type="object" class="oe_stat_button"
                        icon="fa-file-text-o" invisible="not l10n_ae_aigentrix_document_count">
                    <div class="o_field_widget o_stat_info">
                        <field name="l10n_ae_aigentrix_status" class="o_stat_value"/>
                        <span class="o_stat_text">Aigentrix</span>
                    </div>
                </button>
            </xpath>
            <button name="action_invoice_sent" position="before">
                <button name="action_l10n_ae_aigentrix_validate" string="Validate E-Invoice (Aigentrix)" type="object"
                        groups="account.group_account_invoice"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or l10n_ae_aigentrix_document_count"/>
                <button name="action_l10n_ae_aigentrix_submit" string="Submit E-Invoice (Aigentrix)" type="object"
                        groups="account.group_account_invoice"
                        class="oe_highlight"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or l10n_ae_aigentrix_document_count"/>
            </button>
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']" position="after">
                <group string="Aigentrix E-Invoice" name="l10n_ae_aigentrix_info"
                       invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <field name="l10n_ae_aigentrix_invoice_type_code"/>
                        <field name="l10n_ae_aigentrix_transaction_type"/>
                        <field name="l10n_ae_aigentrix_payment_means_code"/>
                        <field name="l10n_ae_aigentrix_buyer_reference"/>
                        <field name="l10n_ae_aigentrix_order_reference"/>
                        <field name="l10n_ae_aigentrix_contract_document_reference"/>
                        <field name="l10n_ae_aigentrix_tax_point_date"/>
                        <field name="l10n_ae_aigentrix_original_invoice_reference" invisible="move_type != 'out_refund'"/>
                        <field name="l10n_ae_aigentrix_original_invoice_reference_date" invisible="move_type != 'out_refund'"/>
                    </group>
                    <group>
                        <field name="l10n_ae_aigentrix_period_start_date"/>
                        <field name="l10n_ae_aigentrix_period_end_date"/>
                        <field name="l10n_ae_aigentrix_delivery_location"/>
                        <field name="l10n_ae_aigentrix_delivery_address_line1"/>
                        <field name="l10n_ae_aigentrix_delivery_city"/>
                        <field name="l10n_ae_aigentrix_delivery_country_id"/>
                        <field name="l10n_ae_aigentrix_delivery_party_name"/>
                        <field name="l10n_ae_aigentrix_delivery_incoterms"/>
                        <field name="l10n_ae_aigentrix_tax_rep_name"/>
                        <field name="l10n_ae_aigentrix_tax_rep_tax_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
