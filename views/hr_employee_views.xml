<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Extended Employee form view to add Employee History widget. -->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.history.employee</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="history" string="Employee History">
                    <widget name="history_employee_timeline"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extended Public Employee form view to add Employee History widget for normal users. -->
    <record id="hr_employee_public_view_form" model="ir.ui.view">
        <field name="name">hr.employee.public.view.form.inherit.history.employee</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="history" string="Employee History">
                    <widget name="history_employee_timeline"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
