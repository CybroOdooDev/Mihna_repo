<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Tree view for the 'hr.resignation' model.-->
    <record id="hr_resignation_view_tree" model="ir.ui.view">
        <field name="name">hr.resignation.view.tree</field>
        <field name="model">hr.resignation</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list string="Employee Resignation">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="employee_contract"/>
                <field name="joined_date" readonly="1"/>
                <field name="expected_revealing_date"/>
                <field name="approved_revealing_date"/>
                <field name="resignation_type"/>
                <field name="notice_period"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <!--Form view for the 'hr.resignation' model.-->
    <record id="hr_resignation_view_form" model="ir.ui.view">
        <field name="name">hr.resignation.view.form</field>
        <field name="model">hr.resignation</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Employee Resignation">
                <header>
                    <button string="Confirm" type="object"
                            name="action_confirm_resignation"
                            invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button string="Manager Approve" type="object"
                            name="action_manager_approve"
                            invisible="state != 'confirm'"/>
                    <button string="HR Approve" type="object"
                            groups="hr.group_hr_user"
                            name="action_approve_resignation"
                            invisible="state != 'manager_approved'"
                            class="oe_highlight"/>
                    <button string="Compute Settlement" type="object"
                            groups="hr.group_hr_user"
                            name="action_compute_settlement"
                            invisible="state != 'clearance' or clearance_progress &lt; 100 or settlement_state == 'computed'"
                            class="oe_highlight"/>
                    <button string="Recompute Settlement" type="object"
                            groups="hr.group_hr_user"
                            name="action_compute_settlement"
                            invisible="state != 'clearance' or settlement_state != 'computed'"/>
                    <button string="Approve Settlement" type="object"
                            groups="hr.group_hr_manager"
                            name="action_approve_settlement"
                            invisible="state != 'clearance' or settlement_state != 'computed'"
                            class="oe_highlight"/>
                    <button string="Relieve Employee" type="object"
                            groups="hr.group_hr_manager"
                            name="action_relieve"
                            invisible="state != 'settlement'"/>
                    <button string="Withdraw" type="object"
                            name="action_withdraw"
                            invisible="state in ['draft', 'cancel', 'relieved']"/>
                    <button string="Reject" type="object"
                            groups="hr.group_hr_user"
                            name="action_reject_resignation"
                            invisible="state not in ['confirm', 'manager_approved', 'approved']"/>
                    <button string="Set to Draft" type="object"
                            groups="hr.group_hr_manager"
                            name="action_reset_to_draft"
                            invisible="state not in ['cancel', 'relieved']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirm,approved,relieved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Employee Details">
                            <field name="change_employee" invisible="1"/>
                            <field name="employee_id"
                                   readonly="change_employee == False or state == 'approved'"/>
                            <field name="department_id"/>
                            <field name="employee_contract"/>
                        </group>
                        <group string="Dates">
                            <field name="joined_date"/>
                            <field name="resign_confirm_date"
                                   readonly="1"
                                   invisible="resign_confirm_date == False"/>
                            <field name="expected_revealing_date"
                                   readonly="state == 'approved'"/>
                            <field name="approved_revealing_date" readonly="1"
                                   groups="hr.group_hr_user"/>
                            <field name="notice_period"/>
                        </group>
                        <group string="Resignation Details">
                            <field name="resignation_type" string="Type"
                                   groups="hr.group_hr_user"
                                   readonly="state == 'relieved'"/>
                            <field name="reason"
                                   readonly="state == 'relieved'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clearance Checklist" name="clearance_page" invisible="state in ('draft', 'confirm', 'manager_approved', 'approved')">
                            <group>
                                <field name="clearance_progress" widget="progressbar"/>
                            </group>
                            <field name="clearance_line_ids">
                                <list editable="bottom">
                                    <field name="clearance_type_id" readonly="1"/>
                                    <field name="department_id" readonly="1"/>
                                    <field name="responsible_user_id"/>
                                    <field name="has_dues"/>
                                    <field name="due_amount" invisible="has_dues == False"/>
                                    <field name="state" widget="badge" decoration-success="state == 'cleared'" decoration-danger="state == 'blocked'"/>
                                    <field name="cleared_date" readonly="1"/>
                                    <field name="remarks"/>
                                    <button name="action_mark_cleared" type="object" icon="fa-check" string="Clear" invisible="state == 'cleared'"/>
                                    <button name="action_mark_blocked" type="object" icon="fa-times" string="Block" invisible="state == 'blocked'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Settlement (F&amp;F)" name="settlement_page" invisible="state in ('draft', 'confirm', 'manager_approved', 'approved')">
                            <group>
                                <group>
                                    <field name="settlement_state" readonly="1"/>
                                    <field name="pending_salary" readonly="settlement_state == 'approved'"/>
                                    <field name="leave_encashment" readonly="settlement_state == 'approved'"/>
                                    <field name="gratuity" readonly="settlement_state == 'approved'"/>
                                    <field name="bonus" readonly="settlement_state == 'approved'"/>
                                </group>
                                <group>
                                    <field name="loan_recovery" readonly="settlement_state == 'approved'"/>
                                    <field name="advance_recovery" readonly="settlement_state == 'approved'"/>
                                    <field name="notice_recovery" readonly="settlement_state == 'approved'"/>
                                    <field name="asset_recovery" readonly="1"/>
                                    <field name="net_settlement" readonly="1"/>
                                    <field name="payslip_id" readonly="1" invisible="payslip_id == False"/>
                                </group>
                            </group>
                        </page>
                        <page string="Analytics &amp; Handover" name="analytics_page">
                            <group>
                                <group>
                                    <field name="reason_category_id"/>
                                    <field name="is_regrettable"/>
                                    <field name="rehire_eligible"/>
                                </group>
                                <group>
                                    <field name="replacement_employee_id" domain="[('id', '!=', employee_id)]"/>
                                    <field name="exit_interview_id"/>
                                    <button name="action_send_exit_interview" type="object" string="Send Exit Interview" class="btn-link"/>
                                </group>
                                <field name="handover_notes" placeholder="Handover notes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                 <chatter/>
            </form>
        </field>
    </record>
    <!--Action for the 'hr.resignation' model.-->
    <record id="hr_resignation_action" model="ir.actions.act_window">
        <field name="name">Employee Resignation</field>
        <field name="res_model">hr.resignation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('draft',
            'confirm','cancel'))]
        </field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the First Resignation
            </p>
        </field>
    </record>
    <!--Action for the 'hr.resignation' model, specifically for viewing approved resignations.-->
    <record id="hr_resignation_approved_action" model="ir.actions.act_window">
        <field name="name">Approved Resignation</field>
        <field name="res_model">hr.resignation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('approved', 'clearance', 'settlement', 'relieved'))]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Approved Resignation
            </p>
        </field>
    </record>
    <!-- Root menu item for Resignation -->
    <menuitem id="hr_resignation_menu_root" name="Resignation"
              groups="base.group_user"
              web_icon="hr_resignation,static/description/icon.png"
              sequence="21"/>
    <!-- Menu item for Resignation Request -->
    <menuitem id="hr_resignation_menu_request"
              parent="hr_resignation_menu_root" name="Resignation Request"
              action="hr_resignation_action" groups="base.group_user"
              sequence="4"/>
    <!-- Menu item for Approved Resignation -->
    <menuitem id="hr_resignation_menu_approved_request"
              parent="hr_resignation_menu_root"
              name="Approved Resignation"
              action="hr_resignation_approved_action"
              groups="hr.group_hr_user"
              sequence="4"/>
</odoo>
