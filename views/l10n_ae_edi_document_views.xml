<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_l10n_ae_edi_document_list" model="ir.ui.view">
        <field name="name">l10n.ae.edi.document.list</field>
        <field name="model">l10n.ae.edi.document</field>
        <field name="arch" type="xml">
            <list string="UAE E-Invoicing Documents" default_order="l10n_ae_edi_issuance_date desc">
                <field name="name"/>
                <field name="move_id"/>
                <field name="l10n_ae_edi_issuance_date"/>
                <field name="asp_reference"/>
                <field name="l10n_ae_edi_state" widget="badge"
                       decoration-success="l10n_ae_edi_state == 'accepted'"
                       decoration-danger="l10n_ae_edi_state in ('rejected', 'error')"
                       decoration-muted="l10n_ae_edi_state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ae_edi_document_form" model="ir.ui.view">
        <field name="name">l10n.ae.edi.document.form</field>
        <field name="model">l10n.ae.edi.document</field>
        <field name="arch" type="xml">
            <form string="UAE E-Invoicing Document">
                <header>
                    <button name="action_retry_submission" string="Retry Submission" type="object"
                            invisible="l10n_ae_edi_state not in ('to_send', 'error')"
                            class="oe_highlight"/>
                    <field name="l10n_ae_edi_state" widget="statusbar" statusbar_visible="to_send,in_progress,accepted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="move_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="l10n_ae_edi_issuance_date"/>
                        </group>
                        <group>
                            <field name="asp_reference"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Invoice XML">
                            <field name="invoice_xml" filename="invoice_xml_fname" widget="binary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ae_edi_document" model="ir.actions.act_window">
        <field name="name">UAE E-Invoicing Documents</field>
        <field name="res_model">l10n.ae.edi.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_ae_edi_document"
              name="UAE E-Invoicing"
              action="action_l10n_ae_edi_document"
              parent="account.menu_finance_entries"
              groups="account.group_account_invoice"
              sequence="60"/>
</odoo>
