<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_braintree" model="ir.ui.view">
        <field name="name">payment.provider.form.braintree</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'braintree'">
                    <field name="braintree_merchant_id"/>
                    <field name="braintree_public_key"/>
                    <field name="braintree_private_key" password="True"/>
                    <field name="braintree_use_sandbox"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>