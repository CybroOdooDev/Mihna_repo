<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_form_inherit_subscription" model="ir.ui.view">
        <field name="name">product.template.form.inherit.subscription</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Subscription Product checkbox -->
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="recurring_ok"/>
                    <label for="recurring_ok"/>
                </span>
            </xpath>
            
            <!-- Add Recurring Prices Notebook Page -->
            <xpath expr="//notebook/page[@name='sales']" position="after">
                <page name="recurring_prices" string="Recurring prices" invisible="not recurring_ok">
                    <field name="subscription_pricing_ids">
                        <list editable="bottom">
                            <field name="plan_id" string="Recurring Plan"/>
                            <field name="pricelist_id" string="Pricelist"/>
                            <field name="price" string="Price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group string="OPTIONS">
                        <group>
                            <field name="accept_one_time"/>
                            <field name="prorated_price"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
