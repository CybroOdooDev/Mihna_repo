<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- B2C invoices only: per Oman's e-invoicing regulations, there is no OTA-issued clearance stamp
         or QR code - only the supplier-generated QR shown here for B2C. B2B/B2G invoices intentionally
         get no QR block. -->
    <template id="l10n_om_edi_report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='total']" position="before">
            <t t-set="l10n_om_edi_document" t-value="o.l10n_om_edi_document_ids[:1]"/>
            <div t-if="o.country_code == 'OM' and not o.partner_id.commercial_partner_id.is_company and l10n_om_edi_document"
                 class="row mb-3">
                <div class="col-3">
                    <span t-field="l10n_om_edi_document.qr_code" t-options="{'widget': 'image', 'width': 100, 'height': 100}"/>
                </div>
                <div class="col-9" t-if="l10n_om_edi_document.asp_reference">
                    ASP Reference: <span t-field="l10n_om_edi_document.asp_reference"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
