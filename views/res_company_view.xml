<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_l10n_ae_ubl_pint" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_ae_ubl_pint</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="l10n_ae_tin" invisible="country_code != 'AE'" placeholder="1234567890"/>
                <field name="l10n_ae_legal_registration_type" invisible="country_code != 'AE'"/>
                <field name="l10n_ae_legal_registration_number" invisible="country_code != 'AE'"/>
            </xpath>
        </field>
    </record>
</odoo>
