<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_l10n_ae_aigentrix" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_ae_aigentrix</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Aigentrix E-Invoice" name="l10n_ae_aigentrix">
                    <group>
                        <group>
                            <field name="l10n_ae_aigentrix_base_url"/>
                            <field name="l10n_ae_aigentrix_api_key" password="True"/>
                        </group>
                        <group>
                            <field name="l10n_ae_aigentrix_company_id"/>
                            <field name="l10n_ae_aigentrix_peppol_participant_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
