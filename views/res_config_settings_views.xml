<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_refund_days</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_pricing_section']" position="inside">
                <setting string="Return Period" help="Number of days the order can be refunded.">
                    <field name="pos_return_period"/>
                    <span> Days</span>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>