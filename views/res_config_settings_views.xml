<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_l10n_ae_aigentrix" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_ae_aigentrix</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='peppol']" position="after">
                <block title="Aigentrix E-Invoice (UAE)" id="l10n_ae_aigentrix_settings">
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_right_pane border-0">
                            <div class="text-muted oe_inline mb-3">
                                Credentials for the Aigentrix E-Invoice External Gateway, used to
                                submit UAE Peppol e-invoices and credit notes.
                            </div>
                            <div class="row">
                                <label string="Base URL" for="l10n_ae_aigentrix_base_url" class="col-lg-3 o_light_label"/>
                                <field name="l10n_ae_aigentrix_base_url"/>
                            </div>
                            <div class="row">
                                <label string="API Key" for="l10n_ae_aigentrix_api_key" class="col-lg-3 o_light_label"/>
                                <field name="l10n_ae_aigentrix_api_key" password="True"/>
                            </div>
                            <div class="row">
                                <label string="Company ID" for="l10n_ae_aigentrix_company_id" class="col-lg-3 o_light_label"/>
                                <field name="l10n_ae_aigentrix_company_id"/>
                            </div>
                            <div class="row">
                                <label string="Peppol Participant ID" for="l10n_ae_aigentrix_peppol_participant_id" class="col-lg-3 o_light_label"/>
                                <field name="l10n_ae_aigentrix_peppol_participant_id"/>
                            </div>
                            <div class="row mt-2" invisible="not l10n_ae_aigentrix_api_key">
                                <div class="col-lg-9 offset-lg-3">
                                    <button name="action_l10n_ae_aigentrix_test_connection" type="object"
                                            string="Test Connection" class="btn-secondary"/>
                                    <div class="text-muted mt-1">
                                        Save your changes first if you just edited the credentials above.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
