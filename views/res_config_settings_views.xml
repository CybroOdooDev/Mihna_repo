<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_delivery_map" model="ir.ui.view">
        <field name="name">res.config.settings.delivery.map</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="delivery_map" string="Delivery Map">
                    <block title="Map Configuration">
                        <setting string="Map API URL">
                            <field name="map_api_url"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>