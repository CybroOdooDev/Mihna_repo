<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_subscription_whatsapp_config_tree" model="ir.ui.view">
        <field name="name">subscription.whatsapp.config.tree</field>
        <field name="model">subscription.whatsapp.config</field>
        <field name="arch" type="xml">
            <list string="WhatsApp UltraMsg Configurations">
                <field name="name"/>
                <field name="instance_id"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_subscription_whatsapp_config_form" model="ir.ui.view">
        <field name="name">subscription.whatsapp.config.form</field>
        <field name="model">subscription.whatsapp.config</field>
        <field name="arch" type="xml">
            <form string="WhatsApp UltraMsg Configuration">
                <sheet>
                    <div class="alert alert-info text-center" role="alert" style="margin-bottom: 20px;">
                        <i class="fa fa-info-circle me-2"/> 
                        Configure your <strong>UltraMsg WhatsApp Gateway</strong> credentials below. 
                        Messages will be dispatched automatically during payment retries and dunning actions.
                    </div>
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. UltraMsg API Configuration"/>
                        </h1>
                    </div>

                    <group>
                        <group string="API Credentials">
                            <field name="instance_id" placeholder="instanceXXXXXX (e.g. instance115242)"/>
                            <field name="token" placeholder="Your UltraMsg Secret Token" password="True"/>
                        </group>
                        <group string="Status">
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_subscription_whatsapp_config" model="ir.actions.act_window">
        <field name="name">WhatsApp Configuration</field>
        <field name="res_model">subscription.whatsapp.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set up your UltraMsg WhatsApp credentials!
            </p>
            <p>
                Provide the Instance ID and Token from your UltraMsg dashboard to enable automated WhatsApp notifications for smart payment retries.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_subscription_whatsapp_config" 
              name="WhatsApp Settings" 
              parent="subscription_menu_configuration" 
              action="action_subscription_whatsapp_config" 
              sequence="80"/>
</odoo>
