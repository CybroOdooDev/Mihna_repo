<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.subscription</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_timesheet.view_order_form_inherit_sale_timesheet"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <!-- Hide standard project and timesheet buttons from the parent views -->
            <xpath expr="//button[@name='action_view_project_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_timesheet']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 1. Inject detailed stat buttons in the header button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-check-square-o" type="object" name="action_view_project_ids">
                    <div class="o_stat_info">
                        <div class="o_row">
                            <span class="o_stat_text fw-bold"><field name="project_count"/> Projects</span>
                        </div>
                        <div class="o_row">
                            <span class="o_stat_text fw-bold"><field name="tasks_count"/> Tasks</span>
                        </div>
                    </div>
                </button>
                <button class="oe_stat_button" icon="fa-clock-o" type="object" name="action_view_timesheet">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="timesheet_count"/> Hours</span>
                        <span class="o_stat_text">Recorded</span>
                    </div>
                </button>
                <button class="oe_stat_button" 
                        icon="fa-line-chart"
                        style="pointer-events: none; cursor: default;">
                    <div class="o_stat_info">
                        <span class="o_stat_text">MRR</span>
                        <span class="o_stat_value"><field name="mrr_total" widget="monetary" options="{'currency_field': 'currency_id'}"/></span>
                    </div>
                </button>
            </xpath>

            <!-- 2. Customize header buttons to match exact mockup labels and sequence -->
            <xpath expr="//button[@name='action_quotation_send']" position="attributes">
                <attribute name="string">Send</attribute>
            </xpath>
            <xpath expr="//button[@name='action_preview_sale_order']" position="attributes">
                <attribute name="string">Preview</attribute>
            </xpath>

            <!-- Inject custom Subscription lifecycle buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_upsell" string="Upsell" type="object" class="btn-secondary" invisible="not plan_id or state not in ('sale', 'done')"/>
                <button name="action_renew" string="Renew" type="object" class="btn-secondary" invisible="not plan_id or state not in ('sale', 'done')"/>
                <button name="action_close" string="Close" type="object" class="btn-secondary" invisible="not plan_id or state not in ('sale', 'done')"/>
            </xpath>

            <!-- 3. Inject premium state and status badges next to the Sheet Title -->
            <xpath expr="//div[hasclass('oe_title')]" position="replace">
                <div class="oe_title" style="max-width: 100% !important; width: 100% !important;">
                    <div class="d-flex justify-content-between align-items-center w-100" style="width: 100% !important; display: flex !important; min-width: 0; margin-bottom: 1rem;">
                        <h1 class="m-0">
                             <field name="name" readonly="1"/>
                        </h1>
                        <div class="d-flex gap-2 ms-auto" style="overflow: visible !important; min-width: max-content !important; flex-shrink: 0 !important; margin-right: 10px;">
                            <span class="badge rounded-pill text-bg-primary px-3 py-2 fw-bold text-white shadow-sm" style="font-size: 12px; background-color: #4f46e5 !important; white-space: nowrap !important; max-width: none !important; width: auto !important; overflow: visible !important; display: inline-block !important;" invisible="not id or not plan_id or subscription_state != '1_draft'">Subscription Quotation</span>
                            <span class="badge rounded-pill text-bg-secondary px-3 py-2 fw-bold text-white shadow-sm" style="font-size: 12px; background-color: #6c757d !important; white-space: nowrap !important; max-width: none !important; width: auto !important; overflow: visible !important; display: inline-block !important;" invisible="not id or not plan_id or subscription_state != '2_renewal'">Renewal</span>
                            <span class="badge rounded-pill text-bg-success px-3 py-2 fw-bold text-white shadow-sm" style="font-size: 12px; background-color: #4caf50 !important; white-space: nowrap !important; max-width: none !important; width: auto !important; overflow: visible !important; display: inline-block !important;" invisible="not id or not plan_id or subscription_state != '3_progress'">In Progress</span>
                            <span class="badge rounded-pill text-bg-info px-3 py-2 fw-bold text-white shadow-sm" style="font-size: 12px; background-color: #17a2b8 !important; white-space: nowrap !important; max-width: none !important; width: auto !important; overflow: visible !important; display: inline-block !important;" invisible="not id or not plan_id or subscription_state != '4_paused'">Paused</span>
                            <span class="badge rounded-pill text-bg-success px-3 py-2 fw-bold text-white shadow-sm" style="font-size: 12px; background-color: #28a745 !important; white-space: nowrap !important; max-width: none !important; width: auto !important; overflow: visible !important; display: inline-block !important;" invisible="not id or not plan_id or subscription_state != '5_renewed'">Renewed</span>
                            <span class="badge rounded-pill text-bg-danger px-3 py-2 fw-bold text-white shadow-sm" style="font-size: 12px; background-color: #dc3545 !important; white-space: nowrap !important; max-width: none !important; width: auto !important; overflow: visible !important; display: inline-block !important;" invisible="not id or not plan_id or subscription_state != '6_churn'">Churned</span>
                            <span class="badge rounded-pill text-bg-primary px-3 py-2 fw-bold text-white shadow-sm" style="font-size: 12px; background-color: #007bff !important; white-space: nowrap !important; max-width: none !important; width: auto !important; overflow: visible !important; display: inline-block !important;" invisible="not id or not plan_id or subscription_state != '7_upsell'">Upsell</span>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- 4. Left Column: Add Referrer below Customer -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="referrer_id" placeholder="Select referrer..."/>
            </xpath>

            <!-- 5. Right Column: Add Recurring Plan, Until, Next Invoice, and Promised Delivery -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <label for="plan_id" string="Recurring Plan"/>
                <div class="o_row">
                    <field name="plan_id" placeholder="Monthly"/>
                    <span class="oe_grey fw-bold">Until</span>
                    <field name="subscription_end_date" placeholder="May 16, 2032"/>
                </div>
                <field name="next_invoice_date" string="Next Invoice"/>
                <field name="payment_token_id" options="{'no_create': True}" invisible="not plan_id"/>
                <field name="dunning_plan_id" invisible="not plan_id"/>
                <field name="next_dunning_date" invisible="not is_in_dunning"/>
                <field name="commitment_date" string="Promised Delivery"/>
            </xpath>



            <!-- 7. Subtotals block: Inject MRR and Non Recurring totals -->
            <xpath expr="//group[@name='sale_total']" position="inside">
                <div class="d-flex justify-content-between border-top pt-2 mt-2">
                    <strong style="color: #666;">MRR:</strong>
                    <field name="mrr_total" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: bold; color: #333;"/>
                </div>
                <div class="d-flex justify-content-between">
                    <strong style="color: #666;">Non Recurring:</strong>
                    <field name="non_recurring_total" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: bold; color: #333;"/>
                </div>
            </xpath>

            <!-- Inject web_ribbon inside the sheet -->
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon" title="Blocked" bg_color="bg-danger" invisible="subscription_state != '8_blocked'"/>
            </xpath>
        </field>
    </record>

    <!-- Custom Tree/List view for Subscription Sales Orders -->
    <record id="view_subscription_order_tree" model="ir.ui.view">
        <field name="name">sale.order.tree.subscription</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Subscriptions" sample="1">
                <field name="name" string="Number"/>
                <field name="partner_id" string="Customer"/>
                <field name="next_invoice_date" string="Next Invoice" optional="show"/>
                <field name="user_id" string="Salesperson" widget="many2one_avatar_user"/>
                <field name="activity_ids" string="Activities" widget="list_activity" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="mrr_total" string="Recurring" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="plan_id" string="Recurring Plan"/>
                <field name="amount_total" string="Total" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-bf="1" decoration-info="1"/>
                <field name="subscription_state" string="Subscription Status" widget="badge"
                       decoration-success="subscription_state == '3_progress'"
                       decoration-info="subscription_state in ('1_draft', '2_renewal')"
                       decoration-warning="subscription_state == '4_paused'"
                       decoration-danger="subscription_state in ('6_churn')"
                       decoration-primary="subscription_state == '7_upsell'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_sales_order_filter_subscription" model="ir.ui.view">
        <field name="name">sale.order.select.subscription</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <field name="name" string="Order"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="plan_id"/>
                <filter string="My Subscriptions" name="my_subscriptions" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="In Progress or Paused" name="active_subscriptions" domain="[('subscription_state', 'in', ['3_progress', '4_paused'])]"/>
                <filter string="In Progress" name="in_progress" domain="[('subscription_state', '=', '3_progress')]"/>
                <filter string="Paused" name="paused" domain="[('subscription_state', '=', '4_paused')]"/>
                <filter string="Churned" name="churned" domain="[('subscription_state', '=', '6_churn')]"/>
                <filter string="To Renew" name="to_renew" domain="[('subscription_state', '=', '2_renewal')]"/>
                <filter string="Upsell" name="upsell" domain="[('subscription_state', '=', '7_upsell')]"/>
                <filter string="In Dunning" name="in_dunning" domain="[('is_in_dunning', '=', True)]"/>
                <separator/>
                <group>
                    <filter string="Customer" name="customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'subscription_state'}"/>
                    <filter string="Recurring Plan" name="plan" context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
