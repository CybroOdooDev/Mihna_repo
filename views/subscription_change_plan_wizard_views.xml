    <!-- Close Subscription Wizard -->
    <record id="view_subscription_close_wizard_form" model="ir.ui.view">
        <field name="name">subscription.close.wizard.form</field>
        <field name="model">subscription.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Subscription">
                <sheet>
                    <group>
                        <field name="subscription_id" readonly="1"/>
                        <field name="close_reason_id"/>
                        <field name="notes" placeholder="Optional notes about the cancellation..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_close" string="Close Subscription"
                            type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

