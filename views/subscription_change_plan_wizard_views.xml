<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Close Subscription Wizard -->
    <record id="view_subscription_close_wizard_form" model="ir.ui.view">
        <field name="name">subscription.close.wizard.form</field>
        <field name="model">subscription.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Subscription">
                <sheet>
                    <group>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="close_reason_id"/>
                        <field name="notes" placeholder="Optional notes about the cancellation..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_close" string="Close Subscription"
                            type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Change Plan Wizard -->
    <record id="view_subscription_change_plan_wizard_form" model="ir.ui.view">
        <field name="name">subscription.change.plan.wizard.form</field>
        <field name="model">subscription.change.plan.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Subscription Plan">
                <sheet>
                    <group>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="plan_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_change_plan" string="Apply New Plan"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
