<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_coupon_list" model="ir.ui.view">
        <field name="name">subscription.coupon.list</field>
        <field name="model">subscription.coupon</field>
        <field name="arch" type="xml">
            <list string="Coupons">
                <field name="name"/>
                <field name="code"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_coupon_form" model="ir.ui.view">
        <field name="name">subscription.coupon.form</field>
        <field name="model">subscription.coupon</field>
        <field name="arch" type="xml">
            <form string="Coupon">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Summer Promo 20%"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="General configuration" name="general">
                            <group>
                                <group>
                                    <field name="code" placeholder="e.g. SAVE20"/>
                                    <field name="discount_type"/>
                                    <field name="discount_value"/>
                                </group>
                                <group>
                                    <field name="active" widget="boolean_toggle"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="recurring_type"/>
                                    <field name="recurring_invoices" invisible="recurring_type != 'limited'" required="recurring_type == 'limited'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Validation Rules" name="validation">
                            <group>
                                <group string="Usage Limits">
                                    <field name="max_uses"/>
                                    <field name="current_uses"/>
                                    <field name="max_uses_per_customer"/>
                                </group>
                                <group string="Order Constraints">
                                    <field name="min_order_amount"/>
                                    <field name="first_time_only"/>
                                    <field name="plan_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subscription_coupon" model="ir.actions.act_window">
        <field name="name">Coupons</field>
        <field name="res_model">subscription.coupon</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
