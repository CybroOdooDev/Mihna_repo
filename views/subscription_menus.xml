<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Menu -->
    <menuitem id="subscription_menu_dashboard" 
              name="Dashboard" 
              parent="subscription_menu_root" 
              action="action_subscription_dashboard"
              sequence="5"/>
              
    <!-- Standard Actions -->
    <record id="action_subscription_subscription_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="subscription_management.view_subscription_order_tree"/>
        <field name="act_window_id" ref="action_subscription_subscription"/>
    </record>
    <record id="action_subscription_subscription_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="subscription_management.view_subscription_order_form"/>
        <field name="act_window_id" ref="action_subscription_subscription"/>
    </record>

    <record id="action_subscription_quotations" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('plan_id', '!=', False), ('subscription_state', 'in', ['1_draft', '2_renewal', '3_progress', '4_paused', '5_renewed', '6_churn', '7_upsell', '8_blocked'])]</field>
        <field name="context">{'default_plan_id': True, 'search_default_my_subscriptions': 1}</field>
        <field name="search_view_id" ref="subscription_management.view_sales_order_filter_subscription"/>
    </record>
    <record id="action_subscription_quotations_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="subscription_management.view_subscription_order_tree"/>
        <field name="act_window_id" ref="action_subscription_quotations"/>
    </record>
    <record id="action_subscription_quotations_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="subscription_management.view_subscription_order_form"/>
        <field name="act_window_id" ref="action_subscription_quotations"/>
    </record>

    <record id="action_subscription_to_renew" model="ir.actions.act_window">
        <field name="name">To Renew</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('plan_id', '!=', False), ('subscription_state', '=', '2_renewal')]</field>
        <field name="context">{'default_plan_id': True}</field>
        <field name="search_view_id" ref="subscription_management.view_sales_order_filter_subscription"/>
    </record>
    <record id="action_subscription_to_renew_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="subscription_management.view_subscription_order_tree"/>
        <field name="act_window_id" ref="action_subscription_to_renew"/>
    </record>
    <record id="action_subscription_to_renew_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="subscription_management.view_subscription_order_form"/>
        <field name="act_window_id" ref="action_subscription_to_renew"/>
    </record>

    <record id="action_subscription_upsells" model="ir.actions.act_window">
        <field name="name">Upsells</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('plan_id', '!=', False), ('subscription_state', '=', '7_upsell')]</field>
        <field name="context">{'default_plan_id': True}</field>
        <field name="search_view_id" ref="subscription_management.view_sales_order_filter_subscription"/>
    </record>
    <record id="action_subscription_upsells_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="subscription_management.view_subscription_order_tree"/>
        <field name="act_window_id" ref="action_subscription_upsells"/>
    </record>
    <record id="action_subscription_upsells_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="subscription_management.view_subscription_order_form"/>
        <field name="act_window_id" ref="action_subscription_upsells"/>
    </record>

    <record id="action_subscription_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('customer_rank', '>', 0)]</field>
    </record>

    <record id="action_subscription_products" model="ir.actions.act_window">
        <field name="name">Subscription Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('recurring_ok', '=', True)]</field>
        <field name="context">{'default_recurring_ok': True}</field>
    </record>

    <!-- Reporting Actions -->
    <record id="action_subscription_reporting_subscriptions" model="ir.actions.act_window">
        <field name="name">Subscriptions Analysis</field>
        <field name="res_model">subscription.analysis.report</field>
        <field name="view_mode">graph,list,pivot</field>
        <field name="context">{'search_default_in_progress_or_paused': 1, 'search_default_recurring': 1, 'graph_measure': 'monthly_recurring'}</field>
    </record>

    <record id="action_subscription_reporting_retention" model="ir.actions.act_window">
        <field name="name">Retention Analysis</field>
        <field name="res_model">subscription.retention.analysis</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[]</field>
        <field name="context">{'pivot_measures': ['count', 'active_count', 'retention_rate']}</field>
    </record>

    <record id="action_subscription_reporting_mrr_breakdown" model="ir.actions.act_window">
        <field name="name">MRR Breakdown</field>
        <field name="res_model">subscription.mrr.breakdown</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="context">{'graph_measure': 'mrr_change', 'graph_group_by': 'event_date', 'graph_stacked': True, 'graph_mode': 'bar'}</field>
    </record>

    <record id="action_subscription_reporting_mrr_timeline" model="ir.actions.act_window">
        <field name="name">MRR Analysis</field>
        <field name="res_model">subscription.mrr.analysis</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{'graph_measure': 'mrr_change', 'graph_group_by': 'date', 'graph_mode': 'line'}</field>
    </record>

    <!-- Sub Menus under Subscriptions -->
    <menuitem id="menu_subscription_quotations" 
              name="Quotations" 
              parent="subscription_menu_subscriptions" 
              action="action_subscription_quotations" 
              sequence="11"/>

    <menuitem id="menu_subscription_to_renew" 
              name="To Renew" 
              parent="subscription_menu_subscriptions" 
              action="action_subscription_to_renew" 
              sequence="12"/>

    <menuitem id="menu_subscription_upsells" 
              name="Upsells" 
              parent="subscription_menu_subscriptions" 
              action="action_subscription_upsells" 
              sequence="13"/>

    <menuitem id="menu_subscription_customers" 
              name="Customers" 
              parent="subscription_menu_subscriptions" 
              action="action_subscription_customers" 
              sequence="14"/>

    <!-- Sub Menus under Products -->
    <menuitem id="menu_subscription_product_template" 
              name="Products" 
              parent="subscription_menu_products" 
              action="action_subscription_products" 
              sequence="10"/>

    <menuitem id="menu_subscription_pricelists" 
              name="Pricelists" 
              parent="subscription_menu_products" 
              action="product.product_pricelist_action2" 
              sequence="20"/>

    <!-- Sub Menus under Reporting -->
    <menuitem id="menu_subscription_reporting_subs" 
              name="Subscriptions" 
              parent="subscription_menu_reporting" 
              action="action_subscription_reporting_subscriptions" 
              sequence="10"/>

    <menuitem id="menu_subscription_reporting_retention" 
              name="Retention" 
              parent="subscription_menu_reporting" 
              action="action_subscription_reporting_retention" 
              sequence="20"/>

    <menuitem id="menu_subscription_reporting_mrr_breakdown" 
              name="MRR Breakdown" 
              parent="subscription_menu_reporting" 
              action="action_subscription_reporting_mrr_breakdown" 
              sequence="30"/>

    <menuitem id="menu_subscription_reporting_mrr_timeline" 
              name="MRR Timeline" 
              parent="subscription_menu_reporting" 
              action="action_subscription_reporting_mrr_timeline" 
              sequence="40"/>

    <!-- Sub Menus under Configuration -->
    <menuitem id="menu_subscription_settings" 
              name="Settings" 
              parent="subscription_menu_configuration" 
              action="sale.action_sale_config_settings" 
              sequence="5"/>

    <menuitem id="menu_subscription_quotation_templates" 
              name="Quotation Templates" 
              parent="subscription_menu_configuration" 
              action="sale_management.sale_order_template_action" 
              sequence="15"/>

    <menuitem id="menu_subscription_activity_types" 
              name="Activity Types" 
              parent="subscription_menu_configuration" 
              action="mail.mail_activity_type_action" 
              sequence="30"/>

    <menuitem id="menu_subscription_activity_plans" 
              name="Activity Plans" 
              parent="subscription_menu_configuration" 
              action="mail.mail_activity_plan_action" 
              sequence="40"/>

    <menuitem id="menu_subscription_coupons" 
              name="Coupons &amp; Loyalty" 
              parent="subscription_menu_configuration" 
              action="loyalty.loyalty_program_discount_loyalty_action" 
              sequence="50"/>

    <menuitem id="menu_subscription_payment_providers" 
              name="Payment Providers" 
              parent="subscription_menu_configuration" 
              action="payment.action_payment_provider" 
              sequence="60"/>

    <menuitem id="menu_subscription_dunning_plans" 
              name="Dunning Plans" 
              parent="subscription_menu_configuration" 
              action="action_subscription_dunning_plan" 
              sequence="70"/>
</odoo>
