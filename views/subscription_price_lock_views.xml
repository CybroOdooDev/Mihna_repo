<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         1.  PRICE CHANGE LOG — LIST VIEW
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_subscription_price_change_log_list" model="ir.ui.view">
        <field name="name">subscription.price.change.log.list</field>
        <field name="model">subscription.price.change.log</field>
        <field name="arch" type="xml">
            <list string="Price Change History" create="false" edit="false" delete="false">
                <field name="change_date"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="old_price" string="Old Price"/>
                <field name="new_price" string="New Price"/>
                <field name="price_diff" string="Change (Δ)"
                       decoration-danger="price_diff &gt; 0"
                       decoration-success="price_diff &lt; 0"/>
                <field name="is_protected" widget="boolean"
                       string="Grandfathered?"
                       decoration-success="is_protected == True"
                       decoration-warning="is_protected == False"/>
                <field name="changed_by"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         2.  PRICE CHANGE LOG — FORM VIEW
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_subscription_price_change_log_form" model="ir.ui.view">
        <field name="name">subscription.price.change.log.form</field>
        <field name="model">subscription.price.change.log</field>
        <field name="arch" type="xml">
            <form string="Price Change Event" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="product_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Event Details">
                            <field name="sale_order_id" readonly="1"/>
                            <field name="change_date" readonly="1"/>
                            <field name="changed_by" readonly="1"/>
                        </group>
                        <group string="Price Change">
                            <field name="old_price" readonly="1"/>
                            <field name="new_price" readonly="1"/>
                            <field name="price_diff" readonly="1"/>
                            <field name="is_protected" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         3.  GLOBAL PRICE HISTORY ACTION (for Reporting menu)
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_subscription_price_change_log" model="ir.actions.act_window">
        <field name="name">Price Change History</field>
        <field name="res_model">subscription.price.change.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No price change events yet.</p>
            <p>Price change events are automatically recorded whenever a product
               price is updated and active subscriptions are affected.</p>
        </field>
    </record>

</odoo>
