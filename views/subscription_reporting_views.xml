<odoo>
    <!-- 1. MRR Breakdown Views -->
    <record id="view_subscription_mrr_breakdown_graph" model="ir.ui.view">
        <field name="name">subscription.mrr.breakdown.graph</field>
        <field name="model">subscription.mrr.breakdown</field>
        <field name="arch" type="xml">
            <graph string="MRR Breakdown" type="bar" sample="1">
                <field name="event_date" interval="month"/>
                <field name="event_type"/>
                <field name="mrr_change" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_mrr_breakdown_pivot" model="ir.ui.view">
        <field name="name">subscription.mrr.breakdown.pivot</field>
        <field name="model">subscription.mrr.breakdown</field>
        <field name="arch" type="xml">
            <pivot string="MRR Breakdown" sample="1">
                <field name="event_date" interval="month" type="row"/>
                <field name="event_type" type="col"/>
                <field name="mrr_change" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- 2. MRR Analysis Views -->
    <record id="view_subscription_mrr_analysis_graph" model="ir.ui.view">
        <field name="name">subscription.mrr.analysis.graph</field>
        <field name="model">subscription.mrr.analysis</field>
        <field name="arch" type="xml">
            <graph string="MRR Analysis" type="line" sample="1">
                <field name="date" interval="month"/>
                <field name="mrr_change" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_mrr_analysis_pivot" model="ir.ui.view">
        <field name="name">subscription.mrr.analysis.pivot</field>
        <field name="model">subscription.mrr.analysis</field>
        <field name="arch" type="xml">
            <pivot string="MRR Analysis" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="mrr_change" type="measure"/>
            </pivot>
        </field>
    </record>

