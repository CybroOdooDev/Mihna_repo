<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         1.  FORM VIEW
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_subscription_subscription_form" model="ir.ui.view">
        <field name="name">subscription.subscription.form</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_activate"   string="Activate"   type="object"
                            class="btn-primary"
                            invisible="state not in ('draft','in_trial')"/>
                    <button name="action_generate_invoice_manually" string="Generate Invoice" type="object"
                            class="btn-primary"
                            invisible="state not in ('in_progress','in_trial')"/>
                    <button name="action_start_trial" string="Start Trial" type="object"
                            class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_pause"      string="Pause"      type="object"
                            class="btn-secondary"
                            invisible="state not in ('in_progress','in_dunning')"/>
                    <button name="action_resume"     string="Resume"     type="object"
                            class="btn-secondary"
                            invisible="state != 'paused'"/>
                    <button name="action_open_change_plan_wizard" string="Change Plan" type="object"
                            class="btn-secondary"
                            invisible="state in ('closed','cancelled','expired')"/>
                    <button name="action_open_close_wizard" string="Close" type="object"
                            class="btn-danger"
                            invisible="state in ('closed','cancelled','expired')"/>
                    <button name="action_cancel"     string="Cancel"     type="object"
                            confirm="Are you sure you want to cancel this subscription?"
                            invisible="state in ('closed','cancelled','expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_trial,in_progress,paused,closed"/>
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not sale_order_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Source Order</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Customer">
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="plan_id"    options="{'no_create': True}"/>
                            <field name="coupon_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Dates &amp; Billing">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="trial_end_date"
                                   invisible="state != 'in_trial'"/>
                            <field name="next_invoice_date"/>
                            <field name="cancel_date"
                                   invisible="state not in ('closed','cancelled')"/>
                            <field name="mrr" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Subscription Lines" name="lines">
                            <field name="line_ids" widget="one2many_list">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="price_unit"/>
                                    <field name="discount" optional="show"/>
                                    <field name="price_subtotal" sum="Subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Close Info" name="close_info"
                              invisible="state not in ('closed','cancelled')">
                            <group>
                                <field name="close_reason_id"/>
                                <field name="close_reason_notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         2.  LIST VIEW
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_subscription_subscription_list" model="ir.ui.view">
        <field name="name">subscription.subscription.list</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions" decoration-info="state == 'draft'"
                  decoration-success="state == 'in_progress'"
                  decoration-warning="state in ('paused','in_dunning','suspended')"
                  decoration-muted="state in ('closed','cancelled','expired')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="next_invoice_date"/>
                <field name="mrr" widget="monetary"
                       options="{'currency_field': 'currency_id'}" sum="Total MRR"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="invoice_count" string="Invoices"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'in_progress'"
                       decoration-info="state in ('draft','in_trial')"
                       decoration-warning="state in ('paused','in_dunning','suspended')"
                       decoration-danger="state in ('closed','cancelled','expired')"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         3.  KANBAN VIEW
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_subscription_subscription_kanban" model="ir.ui.view">
        <field name="name">subscription.subscription.kanban</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="mrr"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="next_invoice_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb8">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="partner_id"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="name"/>
                                    </small>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'in_progress': 'success', 'paused': 'warning', 'closed': 'danger', 'draft': 'info'}}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="text-muted">Plan: </span>
                                <field name="plan_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="fw-bold">MRR: </span>
                                    <field name="mrr" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </div>
                                <div class="oe_kanban_bottom_right text-muted small">
                                    Next: <field name="next_invoice_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         4.  SEARCH VIEW
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_subscription_subscription_search" model="ir.ui.view">
        <field name="name">subscription.subscription.search</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <field name="name" string="Reference"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <!-- Filters -->
                <filter string="Draft"       name="draft"       domain="[('state','=','draft')]"/>
                <filter string="In Trial"    name="in_trial"    domain="[('state','=','in_trial')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Paused"      name="paused"      domain="[('state','=','paused')]"/>
                <filter string="Closed"      name="closed"      domain="[('state','=','closed')]"/>
                <filter string="Cancelled"   name="cancelled"   domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Active" name="active"
                        domain="[('state','in',['in_trial','in_progress','paused','in_dunning'])]"/>
                <!-- Group By -->
                <separator/>
                <filter string="By Plan"       name="group_plan"    context="{'group_by': 'plan_id'}"/>
                <filter string="By Customer"   name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="By State"      name="group_state"   context="{'group_by': 'state'}"/>
                <filter string="By Start Month" name="group_start"  context="{'group_by': 'start_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         5.  WINDOW ACTIONS
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_subscription_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('subscription_state', 'in', ['1_draft', '3_progress', '4_paused', '6_churn'])]</field>
        <field name="context">{'default_plan_id': True, 'search_default_active_subscriptions': 1}</field>
        <field name="search_view_id" ref="subscription_management.view_sales_order_filter_subscription"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No subscriptions yet!
            </p>
            <p>
                Subscriptions are created automatically when a Sales Order containing
                a recurring product is confirmed.
            </p>
        </field>
    </record>

    <record id="action_subscription_subscription_all" model="ir.actions.act_window">
        <field name="name">All Subscriptions</field>
        <field name="res_model">subscription.subscription</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No subscriptions found.</p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         6.  MENU ITEMS (under Subscriptions parent)
         ═══════════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_subscription_all_subscriptions"
              name="Subscriptions"
              parent="subscription_management.subscription_menu_subscriptions"
              action="action_subscription_subscription"
              sequence="10"/>

    <menuitem id="menu_subscription_all_subscriptions_list"
              name="All Subscriptions"
              parent="subscription_management.subscription_menu_subscriptions"
              action="action_subscription_subscription_all"
              sequence="15"/>

</odoo>
