<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_whatsapp_template_form" model="ir.ui.view">
        <field name="name">subscription.whatsapp.template.form</field>
        <field name="model">subscription.whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Template Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="body"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_whatsapp_template_tree" model="ir.ui.view">
        <field name="name">subscription.whatsapp.template.tree</field>
        <field name="model">subscription.whatsapp.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates">
                <field name="name"/>
                <field name="body"/>
            </list>
        </field>
    </record>

    <record id="action_subscription_whatsapp_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">subscription.whatsapp.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_subscription_whatsapp_template" 
              name="WhatsApp Templates" 
              parent="subscription_menu_configuration" 
              action="action_subscription_whatsapp_template" 
              sequence="85"/>
</odoo>
